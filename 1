# these are the dependencies visitor for the python
# this is used by the parser for actually parsing the file
import ast


class DependencyVisitor(ast.NodeVisitor):
    def __init__(self):
        self.imports = []
        self.calls = []

    # Detects: import os OR from math import sqrt
    def visit_Import(self, node):
        for alias in node.names:
            self.imports.append(alias.name)
        self.generic_visit(node)

    def visit_ImportFrom(self, node):
        if node.module:
            self.imports.append(node.module)
        self.generic_visit(node)

    # Detects: self.db.execute() OR print("hello")
    def visit_Call(self, node):
        if isinstance(node.func, ast.Attribute):
            # For method calls like 'self.db.execute'
            self.calls.append(node.func.attr)
        elif isinstance(node.func, ast.Name):
            # For direct calls like 'execute()'
            self.calls.append(node.func.id)
        self.generic_visit(node)
