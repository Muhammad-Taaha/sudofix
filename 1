import psutil
import time
from collections import deque

from textual.app import App, ComposeResult
from textual.containers import Grid
from textual.widgets import Static
from textual.reactive import reactive

from rich.panel import Panel
from rich.text import Text
from rich.table import Table


# ----------------------------
# 📊 CPU GRAPH WIDGET
# ----------------------------
class CPUGraph(Static):
    history = reactive(deque(maxlen=50))

    def on_mount(self):
        self.set_interval(0.1, self.update_graph)

    def update_graph(self):
        cpu = psutil.cpu_percent()
        self.history.append(cpu)
        self.update(self.render_graph())

    def render_graph(self):
        bars = ""

        for val in self.history:
            height = int(val / 10)
            bars += f"[green]{'█' * height}[/green]\n"

        return Panel(
            Text.from_markup(bars),
            title="CPU Usage",
            border_style="green"
        )


# ----------------------------
# 💾 MEMORY WIDGET
# ----------------------------
class MemoryWidget(Static):
    def on_mount(self):
        self.set_interval(0.5, self.update_mem)

    def update_mem(self):
        mem = psutil.virtual_memory()
        percent = mem.percent

        bar = "█" * int(percent / 5)

        text = Text.from_markup(
            f"[cyan]Usage:[/cyan] {percent}%\n[green]{bar}[/green]"
        )

        self.update(Panel(text, title="Memory", border_style="cyan"))


# ----------------------------
# 🌐 NETWORK WIDGET
# ----------------------------
class NetworkWidget(Static):
    def on_mount(self):
        self.last = psutil.net_io_counters()
        self.set_interval(0.5, self.update_net)

    def update_net(self):
        now = psutil.net_io_counters()

        sent = (now.bytes_sent - self.last.bytes_sent) / 1024
        recv = (now.bytes_recv - self.last.bytes_recv) / 1024

        self.last = now

        text = Text.from_markup(
            f"[yellow]Upload:[/yellow] {sent:.2f} KB/s\n"
            f"[blue]Download:[/blue] {recv:.2f} KB/s"
        )

        self.update(Panel(text, title="Network", border_style="yellow"))


# ----------------------------
# 🔥 TOP PROCESSES
# ----------------------------
class ProcessWidget(Static):
    def on_mount(self):
        self.set_interval(1, self.update_proc)

    def update_proc(self):
        processes = []

        for p in psutil.process_iter(['pid', 'name', 'cpu_percent']):
            try:
                processes.append(p.info)
            except:
                pass

        processes = sorted(
            processes, key=lambda x: x['cpu_percent'], reverse=True)[:5]

        table = Table()
        table.add_column("PID")
        table.add_column("Name")
        table.add_column("CPU %")

        for p in processes:
            table.add_row(
                str(p['pid']),
                p['name'][:10],
                str(p['cpu_percent'])
            )

        self.update(Panel(table, title="Top Processes", border_style="red"))


# ----------------------------
# 🧱 MAIN APP
# ----------------------------
class BtopClone(App):
    CSS = """
    Grid {
        grid-size: 2 2;
        grid-gap: 1;
    }
    """

    def compose(self) -> ComposeResult:
        yield Grid(
            CPUGraph(),
            MemoryWidget(),
            NetworkWidget(),
            ProcessWidget(),
        )


# ----------------------------
# ▶ RUN
# ----------------------------
if __name__ == "__main__":
    BtopClone().run()
